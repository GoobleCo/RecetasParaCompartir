# Copiá este archivo como .env y completá con los datos de Supabase
# (Supabase → Project Settings → API). La "anon/publishable key" es PÚBLICA por diseño:
# la seguridad real está en las políticas RLS de la base de datos.
# NUNCA pongas acá la service_role / secret key.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-O-PUBLISHABLE-KEY
# Proveedores de login social habilitados en Supabase, separados por coma: github,google
EXPO_PUBLIC_OAUTH_PROVIDERS=github
